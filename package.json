{
  "name": "@workspace/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src tsup.config.ts",
    "format": "prettier --write \"{src/**/*.ts,tsup.config.ts}\"",
    "typecheck": "tsc --noEmit",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "db:generate": "drizzle-kit generate --config src/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config src/database/drizzle.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "nodemailer": "^7.0.9",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
